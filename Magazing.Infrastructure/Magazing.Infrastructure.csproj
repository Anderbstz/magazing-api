    <ItemGroup>
      <ProjectReference Include="..\Magazing.Domain\Magazing.Domain.csproj" />
      <ProjectReference Include="..\Magazing.Application\Magazing.Application.csproj" />
    </ItemGroup>

    <ItemGroup>
      <None Update="Adapters\MachineLearning\demand-forecast.onnx" Link="MachineLearning\demand-forecast.onnx" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
